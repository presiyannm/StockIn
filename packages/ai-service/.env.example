ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a single workspace
ANTHROPIC_WORKSPACE_ID=
# Leave these empty to use the defaults: extract-invoice claude-opus-5-5,
# identify-product claude-sonnet-5-5, draft-message claude-haiku-5-5.
# CLAUDE_MODEL forces one model for all three (e.g. claude-haiku-5-5 for cheap testing).
CLAUDE_MODEL=
CLAUDE_MODEL_EXTRACT_INVOICE=
CLAUDE_MODEL_IDENTIFY_PRODUCT=
CLAUDE_MODEL_DRAFT_MESSAGE=

PORT=3002

# Must match AI_SERVICE_TOKEN in packages/api/.env
AI_SERVICE_TOKEN=
